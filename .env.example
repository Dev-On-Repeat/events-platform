# -----------------------------------------------------------------------------
# EventPulse Platform — Environment Configuration Template
# -----------------------------------------------------------------------------

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Convex Backend & Database (Run `npx convex dev` to initialize your deployment)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Payment Configuration (Mode: 'mock' for local development & testing, 'razorpay' for live)
PAYMENT_MODE=mock

# Razorpay Credentials (required when PAYMENT_MODE=razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Security Secrets (Generate random 32-character strings for production)
TICKET_SECRET=your-ticket-encryption-secret
AUTH_SECRET=your-admin-session-auth-secret
