# =============================================================================
# HackB4 Events Platform — Production & Development Environment Template
# =============================================================================
# In production on Hostinger: Copy this file to `.env.local` or `.env` and fill
# in the live credentials before running `npm run build`.
# =============================================================================

# 1. Application URL (Domain where HackB4 is hosted)
# For local development: http://localhost:3000
# For production: https://tickets.yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. Convex Database & Realtime Backend
# Generated automatically when you run `npx convex dev` or deploy to Convex Cloud
# Free tier gives 1M reads/month and 250k writes/month ($0 cost)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# 3. Payment Gateway Configuration
# Mode: 'mock' for instant zero-card test purchases (local dev)
# Mode: 'razorpay' for real live payments deposited to client's bank account
PAYMENT_MODE=mock

# 4. Razorpay API Credentials (Get from https://dashboard.razorpay.com/app/keys)
# Free setup, zero monthly subscription fees
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Razorpay Webhook Secret (Set up in Razorpay Dashboard > Settings > Webhooks)
# Webhook URL to configure: https://tickets.yourdomain.com/api/webhooks/razorpay
# Events to subscribe: payment.captured, order.paid
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# 5. Security & Encryption Secrets
# Generate random 32+ character strings (e.g. `openssl rand -hex 32`)
TICKET_SECRET=hackb4_production_ticket_verification_secret_change_me
AUTH_SECRET=hackb4_production_admin_session_secret_change_me
